{{!
    @template enrol_wallet/pricing_table

    Modern responsive pricing cards table for course enrolment options.
}}
<div class="wallet-pricing-wrapper my-4">
    {{#hastitle}}
    <div class="wallet-pricing-header text-center mb-4">
        {{#title}}<h2 class="wallet-pricing-title fw-bold mb-2">{{title}}</h2>{{/title}}
        {{#subtitle}}<p class="wallet-pricing-subtitle text-muted fs-6 mb-3">{{subtitle}}</p>{{/subtitle}}
        
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mb-2">
            {{#showbalance}}
            <div class="wallet-pricing-balance-badge d-inline-flex align-items-center px-3 py-1 rounded-pill bg-light border shadow-sm">
                <span class="wallet-icon-badge me-2 ms-2">💳</span>
                <span class="wallet-balance-text">
                    {{#str}} availablebalance, enrol_wallet {{/str}} 
                    <strong class="text-primary">{{userbalance}} {{currency}}</strong>
                </span>
                {{#topupurl}}
                <a href="{{topupurl}}" class="btn btn-sm btn-outline-primary ms-3 me-3 py-0 px-2 rounded-pill">
                    {{#str}} topup, enrol_wallet {{/str}}
                </a>
                {{/topupurl}}
            </div>
            {{/showbalance}}

            {{#has_region_switcher}}
            <div class="wallet-pricing-region-switcher d-inline-flex align-items-center p-1 rounded-pill bg-light border shadow-sm">
                {{#is_admin_preview}}
                <span class="text-primary small px-2 fw-semibold">🛠️ {{#str}} admin_preview, enrol_wallet {{/str}}:</span>
                {{/is_admin_preview}}
                {{^is_admin_preview}}
                <span class="text-muted small px-2 d-none d-sm-inline">🌍 {{#str}} selectcountry, enrol_wallet {{/str}}:</span>
                {{/is_admin_preview}}
                <div class="btn-group btn-group-sm" role="group">
                    {{#region_switcher}}
                    <a href="{{switch_url}}" class="btn btn-sm rounded-pill px-3 py-1 {{#is_active}}btn-primary active text-white fw-bold shadow-sm{{/is_active}}{{^is_active}}btn-light text-secondary{{/is_active}}">
                        {{label}}
                    </a>
                    {{/region_switcher}}
                </div>
            </div>
            {{/has_region_switcher}}
        </div>
    </div>
    {{/hastitle}}

    <div class="wallet-pricing-grid row g-4 justify-content-center">
        {{#cards}}
        <div class="{{colclass}} d-flex">
            <div class="card wallet-pricing-card w-100 border-0 shadow-sm rounded-4 position-relative d-flex flex-column {{#is_featured}}is-featured{{/is_featured}}"
                 style="--card-accent-color: {{accentcolor}};">
                
                {{#badge}}
                <div class="wallet-card-badge position-absolute top-0 end-0 translate-middle-y me-3 px-3 py-1 rounded-pill text-white fw-bold shadow-sm"
                     style="background: {{accentcolor}};">
                    {{badge}}
                </div>
                {{/badge}}

                <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 text-center">
                    <h4 class="card-title fw-bold mb-1">{{name}}</h4>
                    {{#duration}}
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 mt-1">
                        ⏱️ {{duration}}
                    </span>
                    {{/duration}}
                </div>

                <div class="card-body px-4 py-3 d-flex flex-column">
                    <div class="wallet-pricing-cost text-center my-3">
                        {{#has_discount}}
                        <div class="text-muted text-decoration-line-through fs-6 mb-1">
                            {{cost_before}} {{currency}}
                        </div>
                        {{/has_discount}}
                        <div class="d-flex align-items-baseline justify-content-center">
                            <span class="display-5 fw-extrabold text-dark fw-bold me-1 ms-1">{{cost}}</span>
                            <span class="fs-5 text-muted fw-semibold">{{currency}}</span>
                        </div>
                    </div>

                    {{#features.length}}
                    <div class="wallet-pricing-features-wrap my-3 flex-grow-1">
                        <ul class="list-unstyled mb-0">
                            {{#features}}
                            <li class="d-flex align-items-start mb-2 {{#is_disabled}}text-muted text-decoration-line-through opacity-75{{/is_disabled}}">
                                {{#is_disabled}}
                                <span class="feature-icon text-muted me-2 ms-2 fs-6">✕</span>
                                {{/is_disabled}}
                                {{^is_disabled}}
                                <span class="feature-icon text-success me-2 ms-2 fs-6">✓</span>
                                {{/is_disabled}}
                                <span>{{text}}</span>
                            </li>
                            {{/features}}
                        </ul>
                    </div>
                    {{/features.length}}

                    <div class="wallet-pricing-actions mt-auto pt-3 border-top">
                        {{#is_enrolled}}
                        <div class="alert alert-success py-2 px-3 text-center mb-2 rounded-3 small">
                            {{#str}} alreadyenroled, enrol_wallet {{/str}}
                        </div>
                        <a href="{{courseurl}}" class="btn btn-outline-success w-100 py-2 rounded-3 fw-bold">
                            {{#str}} gotocourse, core {{/str}}
                        </a>
                        {{/is_enrolled}}

                        {{^is_enrolled}}
                            {{#can_enrol_balance}}
                            <form action="{{confirmpage}}" method="post" class="mb-2">
                                <input type="hidden" name="id" value="{{courseid}}">
                                <input type="hidden" name="instance" value="{{instanceid}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-bold shadow-sm">
                                    {{#str}} enrolselfbutton, enrol_wallet {{/str}}
                                </button>
                            </form>
                            {{/can_enrol_balance}}

                            {{#can_direct_pay}}
                            <button
                                class="btn btn-primary w-100 py-2 rounded-3 fw-bold shadow-sm mb-2"
                                type="button"
                                style="background-color: {{accentcolor}}; border-color: {{accentcolor}};"
                                data-action="core_payment/triggerPayment"
                                data-component="enrol_wallet"
                                data-paymentarea="walletenrol"
                                data-itemid="{{payment_itemid}}"
                                data-cost="{{payment_cost}}"
                                data-successurl="{{payment_successurl}}"
                                data-description="{{payment_description}}"
                            >
                                💳 {{#str}} sendpaymentbutton, enrol_wallet {{/str}} ({{payment_cost}})
                            </button>
                            {{/can_direct_pay}}

                            {{#restriction_msg}}
                            <div class="alert alert-warning py-2 px-3 text-center mb-2 rounded-3 small">
                                {{{restriction_msg}}}
                            </div>
                            {{/restriction_msg}}
                        {{/is_enrolled}}

                        {{! Utility Collapsible (Coupon & Topup) }}
                        {{^is_enrolled}}
                        <div class="wallet-card-utilities text-center mt-2 pt-1">
                            {{#coupons_enabled}}
                            <button class="btn btn-link btn-sm text-decoration-none p-0 text-secondary me-2 ms-2"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#coupon-collapse-{{instanceid}}"
                                    aria-expanded="false">
                                🏷️ {{#str}} applycoupon, enrol_wallet {{/str}}
                            </button>
                            {{/coupons_enabled}}

                            {{#show_topup_link}}
                            <a href="{{topupurl}}" class="btn btn-link btn-sm text-decoration-none p-0 text-secondary me-2 ms-2">
                                ➕ {{#str}} topup, enrol_wallet {{/str}}
                            </a>
                            {{/show_topup_link}}

                            {{#coupons_enabled}}
                            <div class="collapse mt-2" id="coupon-collapse-{{instanceid}}">
                                <form action="{{coupon_action_url}}" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="instanceid" value="{{instanceid}}">
                                    <input type="hidden" name="courseid" value="{{courseid}}">
                                    <input type="hidden" name="url" value="{{enrol_page_url}}">
                                    <input type="hidden" name="submitcoupon" value="1">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <input type="text" name="coupon" class="form-control form-control-sm" placeholder="{{#str}} couponcode, enrol_wallet {{/str}}" required>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        {{#str}} apply, core {{/str}}
                                    </button>
                                </form>
                            </div>
                            {{/coupons_enabled}}
                        </div>
                        {{/is_enrolled}}
                    </div>
                </div>
            </div>
        </div>
        {{/cards}}
    </div>
</div>

{{#js}}
require(['core_payment/gateways_modal'], function(modal) {
    modal.init();
});
{{/js}}
